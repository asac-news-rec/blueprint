<mxfile host="app.diagrams.net"><diagram id="feast-flow" name="로그 → 추론 서버"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="log" value="&lt;b&gt;로깅 서버 → PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;served·actions 로그&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="200" height="52" as="geometry"/></mxCell><mxCell id="gcs" value="&lt;b&gt;GCS 원본&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;export_behavior_logs DAG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="200" height="52" as="geometry"/></mxCell><mxCell id="raw" value="&lt;b&gt;BigQuery raw&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;load_raw (아직 없음)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="200" height="52" as="geometry"/></mxCell><mxCell id="clean" value="&lt;b&gt;BigQuery clean&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;clean_events (아직 없음)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="200" height="52" as="geometry"/></mxCell><mxCell id="src" value="&lt;b&gt;BigQuery 원천 표&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;offline, 지금은 dev_yoonmo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=13;fillCo